# User API credentials from https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=replace_me

# Bot created through @BotFather. The recipient must first press Start in the bot.
BOT_TOKEN=123456:replace_me
NOTIFY_CHAT_ID=123456789

# A persistent local MTProto session. The first launch asks for phone/code/2FA.
TG_SESSION=gift_tracking

# Monitoring cadence. Ten collections are checked every five seconds by default.
POLL_INTERVAL_SECONDS=5
COLLECTIONS_PER_CYCLE=10
CATALOG_REFRESH_SECONDS=3600

# Optional: comma-separated slug prefixes for faster focused monitoring.
# Example: PlushPepe,AstralShard
GIFT_COLLECTIONS=

# Optional notification filters.
# Only notify when the owner has a public @username.
REQUIRE_OWNER_USERNAME=false
# Ignore marketplace-like usernames, case-insensitive substring match.
BLOCKED_OWNER_USERNAME_SUBSTRINGS=bank,storage
# Comma-separated backdrop names, for example: Coral Red,Ocean Blue
BACKDROP_FILTERS=

# Optional Gift Satellite price integration.
# Key is issued by @gift_satellite_bot; URL is discovered from the mini-app.
SATELLITE_API_KEY=
SATELLITE_API_URL=

# Historical gifts are not sent on the first launch. Set a positive number to backfill.
BACKFILL_COUNT=0
MAX_NEW_GIFTS_PER_CHECK=100
TIMEZONE=Europe/Minsk
DATABASE_PATH=gift_tracking.sqlite3
LOG_LEVEL=INFO

# Optional TLS overrides for Bot API requests.
# BOT_API_CA_FILE=/path/to/corporate-root-ca.pem
# BOT_API_INSECURE_SSL=true
